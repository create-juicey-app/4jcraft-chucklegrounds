!/subprojects/
/subprojects/*
!/subprojects/*.wrap
!/subprojects/packagefiles
/android/.gradle/
/android/app/build/
/android/.idea/
/android/build/
/android/.cxx/
/android/app/.cxx/
/build-android*/
**/libmain.so
/scripts/__pycache__/
